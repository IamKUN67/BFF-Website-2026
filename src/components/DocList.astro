---
// รายการเอกสารให้ดาวน์โหลด docs = [{ title, note, href, ext, size }]
import Icon from './Icon.astro';
import { labels } from '../lib/site';
const { docs = [] } = Astro.props;
---
<ul class="doc-list">
  {docs.map((d: any) => (
    <li class="doc">
      <span class="doc-ext" aria-hidden="true">{d.ext || 'FILE'}</span>
      <span class="doc-text">
        <strong>{d.title}</strong>
        {d.note && <span>{d.note}</span>}
        {d.size && <small>{d.ext} · {d.size}</small>}
      </span>
      <a class="btn btn-outline doc-dl" href={d.href} download><Icon name="download" size={18} />{labels.docDownload}<span class="sr-only"> {d.title}</span></a>
    </li>
  ))}
</ul>
