---
// "ส่วนเนื้อหา": หัวข้อ → รูปประกอบ + ข้อความ → อัลบั้ม → วิดีโอ YouTube ทุกอย่างปรับขนาด (%) และตำแหน่ง (ซ้าย/กลาง/ขวา) ได้
import { img, md, youtubeId, labels } from '../lib/site';
const { sections = [] } = Astro.props;
const pick = (v: any, ok: string[], d: string) => (ok.includes(v) ? v : d);
const LR = ['left', 'center', 'right'];
const RATIO: Record<string, string> = { '16:9': '16 / 9', '4:3': '4 / 3', '1:1': '1 / 1', '9:16': '9 / 16' };
---
{sections.map((s: any) => {
  const where = `(ส่วน: ${s.title ?? ''})`;
  const lead = img(s.image, where);
  const html = md(s.text);
  const size: number = s.imageSize ?? 50;
  const align = pick(s.imageAlign, LR, 'left');
  const pos = size >= 100 ? 'block-full' : !html || align === 'center' || size > 60 ? `block-${align}` : `float-${align}`;
  const ta = pick(s.textAlign, [...LR, 'justify'], 'left');
  const fs = pick(s.textSize, ['normal', 'large', 'xlarge'], 'normal');
  const tta = pick(s.titleAlign, LR, 'left');
  const tfs = pick(s.titleSize, ['normal', 'large', 'xlarge'], 'normal');
  const cols = pick(String(s.albumSize ?? '3'), ['2', '3', '4', '5', '6'], '3');
  const albumW: number = s.albumWidth ?? 100;
  const albumA = pick(s.albumAlign, LR, 'center');
  const album = (s.album ?? []).map((a: any) => img(a, where)).filter(Boolean) as { src: string; alt: string }[];
  const videos = (s.videos ?? []).filter((v: any) => v?.url).map((v: any) => ({ ...v, id: youtubeId(v.url) }));
  return (
    <section class="sec" data-lb-scope>
      {s.title && <h2 class={`sec-title ta-${tta} fs-${tfs}`}>{s.title}</h2>}
      {(lead || html) && (
        <div class="sec-main">
          {lead && (
            <button type="button" class={`zoom sec-image ${pos}`} style={`--w:${size}%`} data-zoom aria-label={lead.alt ? undefined : labels.zoomImage}>
              <img src={lead.src} alt={lead.alt} loading="lazy" decoding="async" />
            </button>
          )}
          {html && <div class={`prose ta-${ta} fs-${fs}`} set:html={html} />}
        </div>
      )}
      {album.length > 0 && (
        <div class={`blk al-${albumA} album-box`} style={`--w:${albumW}%`}>
          <div class="album" style={`--cols:${cols}`}>
            {album.map((a) => (
              <button type="button" class="zoom" data-zoom aria-label={a.alt ? undefined : labels.zoomImage}>
                <img src={a.src} alt={a.alt} loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        </div>
      )}
      {videos.length > 0 && (
        <div class={`videos jc-${pick(s.videosAlign, LR, 'center')}`}>
          {videos.map((v: any) => (
            <figure class={`video${v.ratio === '9:16' ? ' vertical' : ''}`} style={`--w:${v.width ?? 100}%;--r:${RATIO[v.ratio] ?? '16 / 9'}`}>
              {v.id ? (
                <iframe src={`https://www.youtube-nocookie.com/embed/${v.id}`} title={v.title ?? labels.videoDefaultTitle} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
              ) : (
                <a href={v.url} target="_blank" rel="noopener">{v.title ?? v.url}</a>
              )}
              {v.id && v.title && <figcaption>{v.title}</figcaption>}
            </figure>
          ))}
        </div>
      )}
    </section>
  );
})}
