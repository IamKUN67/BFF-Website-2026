---
// ส่วนต้อนรับ: ตัวอักษรย่อ (BFF) ใหญ่ + หัวใจมิตรภาพ
import { url, img, labels } from '../lib/site';
const { site } = Astro.props;
const initials = site.siteName.split(/\s+/).map((w: string) => w[0]).join('').toUpperCase();
const cover = img(site.cover, '(รูปปก)');
const heart = 'M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z';
---
<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <svg class="heart h1" viewBox="0 0 24 24"><path d={heart} /></svg>
    <svg class="heart h2" viewBox="0 0 24 24"><path d={heart} /></svg>
    <svg class="heart h3" viewBox="0 0 24 24"><path d={heart} /></svg>
  </div>
  <div class="container hero-inner">
    <p class="hero-initials" aria-hidden="true">{initials}</p>
    <h1>{site.welcomeTitle ?? site.siteName}</h1>
    {site.tagline && <p class="hero-tagline">{site.tagline}</p>}
    {site.welcomeText && <p class="hero-text">{site.welcomeText}</p>}
    <a class="btn" href={url('/news/')}>{labels.heroCta}</a>
    {cover && <img class="hero-cover" src={cover.src} alt={cover.alt} />}
  </div>
</section>
