---
// ส่วนต้อนรับ: ตัวอักษรย่อ (BFF) 3 สีตามโลโก้ + รูปโลโก้
import { url, img, labels } from '../lib/site';
const { site } = Astro.props;
const letters = [...site.siteName.split(/\s+/).map((w: string) => w[0]).join('').toUpperCase()];
const logo = img(site.logo, '(โลโก้)');
const cover = img(site.cover, '(รูปปก)');
---
<section class="hero">
  <div class:list={['container', 'hero-inner', logo && 'has-logo']}>
    <div class="hero-copy">
      <p class="hero-initials" aria-hidden="true">{letters.map((l) => <span>{l}</span>)}</p>
      <h1>{site.welcomeTitle ?? site.siteName}</h1>
      {site.tagline && <p class="hero-tagline">{site.tagline}</p>}
      {site.welcomeText && <p class="hero-text">{site.welcomeText}</p>}
      <a class="btn" href={url('/news/')}>{labels.heroCta}</a>
    </div>
    {logo && <img class="hero-logo" src={logo.src} alt={logo.alt} width="600" height="600" />}
  </div>
  {cover && <div class="container"><img class="hero-cover" src={cover.src} alt={cover.alt} /></div>}
</section>
