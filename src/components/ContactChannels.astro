---
// การ์ดช่องทางติดต่อของเว็บ: ดึงจากหน้าตั้งค่าเว็บไซต์ (อีเมล โซเชียล ที่อยู่)
import Icon from './Icon.astro';
import { labels } from '../lib/site';
import { platforms } from '../lib/social';
const { site } = Astro.props;
const social = site.social as Record<string, string | null | undefined>;
const channels = platforms.filter((p) => social[p.key]);
const hasAny = channels.length > 0 || site.email || site.address;
---
{hasAny ? (
  <div class="contact-cards">
    {site.email && (
      <a class="contact-card" href={`mailto:${site.email}`}>
        <span class="cc-icon"><Icon name="mail" /></span>
        <span><span class="cc-label">{labels.emailLabel}</span><span class="cc-value">{site.email}</span></span>
      </a>
    )}
    {channels.map((p) => (
      <a class="contact-card" href={social[p.key]!} target="_blank" rel="noopener">
        <span class="cc-icon"><Icon name={p.key} /></span>
        <span><span class="cc-label">{p.name}</span><span class="cc-value">{labels.openChannel}<span class="sr-only"> ({labels.externalHint})</span></span></span>
      </a>
    ))}
    {site.address && (
      <div class="contact-card">
        <span class="cc-icon" aria-hidden="true">⌂</span>
        <span><span class="cc-label">{labels.addressLabel}</span><span class="cc-value pre">{site.address}</span></span>
      </div>
    )}
  </div>
) : (
  <p class="empty">{labels.contactEmpty}</p>
)}
