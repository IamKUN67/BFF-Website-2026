---
// ท้ายเว็บ: ชื่อเว็บ + ไอคอนโซเชียล (Facebook/YouTube/Discord แสดงเสมอ ถ้ายังไม่ใส่ลิงก์จะเป็นไอคอนจางๆ)
import Icon from './Icon.astro';
import { labels } from '../lib/site';
import { platforms } from '../lib/social';
const { site } = Astro.props;
const items = platforms
  .map((p) => ({ ...p, href: (site.social as Record<string, string | null | undefined>)[p.key] }))
  .filter((p) => p.href || p.always);
---
<footer class="site-footer">
  <div class="container">
    <p class="footer-brand">{site.siteName}</p>
    <ul class="social-icons">
      {items.map((p) => (
        <li>
          {p.href ? (
            <a class="soc" href={p.href} target="_blank" rel="noopener" aria-label={`${p.name} (${labels.externalHint})`}><Icon name={p.key} size={22} /></a>
          ) : (
            <span class="soc is-empty" aria-hidden="true"><Icon name={p.key} size={22} /></span>
          )}
        </li>
      ))}
    </ul>
    {site.footerText && <p class="footer-text">{site.footerText}</p>}
  </div>
</footer>
