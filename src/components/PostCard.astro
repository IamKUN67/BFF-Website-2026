---
// การ์ดข่าว (กดได้ทั้งใบ)
import { url, img, fmtDate, iso, labels } from '../lib/site';
const { post } = Astro.props;
const d = post.data;
const cover = img(d.cover, `(ข่าว: ${d.title})`);
const href = url(`/news/${post.id}/`);
const isUpdated = !!(d.updated && d.date && d.updated.getTime() - d.date.getTime() >= 86400000);
---
<article class="card">
  {cover ? (
    <img class="card-media" src={cover.src} alt={cover.alt} loading="lazy" decoding="async" />
  ) : (
    <div class="card-media placeholder" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" /></svg>
    </div>
  )}
  <div class="card-body">
    <div class="badges">
      {d.pinned && <span class="badge badge-pin">{labels.pinnedBadge}</span>}
      {d.isNew && <span class="badge badge-new">{labels.newBadge}</span>}
      {isUpdated && <span class="badge badge-upd">{labels.updateBadge}</span>}
      {d.category && <span class="badge badge-cat">{d.category}</span>}
    </div>
    <h3><a href={href}>{d.title}</a></h3>
    {d.date && <time datetime={iso(d.date)}>{fmtDate(d.date)}</time>}
  </div>
</article>
