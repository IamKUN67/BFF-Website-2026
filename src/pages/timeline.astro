---
// ไทม์ไลน์และความทรงจำ: เส้นทางงูแยกตามปี (เหตุการณ์ที่ผู้ดูแลเพิ่ม = ใหญ่ / ข่าวที่เผยแพร่และมีวันที่ = บรรทัดเล็ก) เลือกเรียงเก่า→ใหม่ หรือ ใหม่→เก่าได้
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPublishedPosts, labels, url, img, md, fmtDate, iso } from '../lib/site';

type Photo = { src: string; alt: string };
type Item = { date: Date; yearOnly: boolean; title: string; html: string; photo: Photo | null; href: string | null; external: boolean; major: boolean; size: number; align: string; ta: string; fs: string };
const pick = (v: any, ok: string[], x: string) => (ok.includes(v) ? v : x);
const items: Item[] = [];
const manual = new Map<number, (Photo | null)[]>(); // รูปจากอัลบั้มในเหตุการณ์ที่เพิ่มเอง: แสดงทั้งหมด
const pool = new Map<number, (Photo | null)[]>(); // รูปจากข่าว: สุ่มมาแสดง = จำนวนข่าวในปีนั้น × 1.5
const newsCount = new Map<number, number>();
const add = (m: Map<number, (Photo | null)[]>, y: number, list: (Photo | null)[]) => m.set(y, [...(m.get(y) ?? []), ...list]);

for (const m of await getCollection('milestones')) {
  const d = m.data;
  const where = `(ไทม์ไลน์: ${d.title})`;
  const photo = img(d.image, where);
  items.push({ date: d.date, yearOnly: d.yearOnly, title: d.title, html: md(d.text), photo, href: d.link ? url(d.link) : null, external: /^https?:/i.test(d.link ?? ''), major: true, size: d.imageSize ?? 100, align: pick(d.imageAlign, ['left', 'center', 'right'], 'left'), ta: pick(d.textAlign, ['left', 'center', 'right', 'justify'], 'left'), fs: pick(d.textSize, ['normal', 'large', 'xlarge'], 'normal') });
  add(manual, d.date.getUTCFullYear(), d.album.map((a) => img(a, where)));
}
for (const p of await getPublishedPosts()) {
  const d = p.data;
  if (!d.date) continue;
  const where = `(ข่าว: ${d.title})`;
  items.push({ date: d.date, yearOnly: false, title: d.title, html: '', photo: null, href: url(`/news/${p.id}/`), external: false, major: false, size: 100, align: 'left', ta: 'left', fs: 'normal' });
  newsCount.set(d.date.getUTCFullYear(), (newsCount.get(d.date.getUTCFullYear()) ?? 0) + 1);
  add(pool, d.date.getUTCFullYear(), [img(d.cover, where), ...d.sections.flatMap((s) => [img(s.image, where), ...s.album.map((a) => img(a, where))])]);
}

const years = [...new Set(items.map((i) => i.date.getUTCFullYear()))].sort((a, b) => a - b);
const byYear = (y: number) => items.filter((i) => i.date.getUTCFullYear() === y).sort((a, b) => a.date.getTime() - b.date.getTime());
// สุ่มแบบคงที่ (ใช้ปีเป็นเมล็ด) สำหรับการแสดงผลครั้งแรก — เมื่อเปิดหน้าเว็บ จะสุ่มใหม่ทุกครั้งในเบราว์เซอร์
const seeded = (seed: number) => {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let x = Math.imul(a ^ (a >>> 15), 1 | a);
    x = (x + Math.imul(x ^ (x >>> 7), 61 | x)) ^ x;
    return ((x ^ (x >>> 14)) >>> 0) / 4294967296;
  };
};
const memories = (y: number) => {
  const taken = new Set(byYear(y).map((i) => i.photo?.src).filter(Boolean) as string[]);
  const uniq = (list: (Photo | null)[]) => list.filter((p): p is Photo => !!p && !taken.has(p.src) && !!taken.add(p.src));
  const man = uniq(manual.get(y) ?? []);
  const all = uniq(pool.get(y) ?? []);
  const rnd = seeded(y);
  for (let k = all.length - 1; k > 0; k--) {
    const r = Math.floor(rnd() * (k + 1));
    [all[k], all[r]] = [all[r], all[k]];
  }
  return { man, pool: all, quota: Math.min(all.length, Math.ceil((newsCount.get(y) ?? 0) * 1.5)) };
};
---
<Base title={labels.timelineTitle}>
  <section class="section">
    <div class="container" data-timeline>
      <div class="section-head"><h1 class="section-title">{labels.timelineTitle}</h1></div>
      {years.length > 0 ? (
        <>
          <div class="tl-tools" role="group" aria-label={labels.timelineSortLabel}>
            <span>{labels.timelineSortLabel}</span>
            <button type="button" class="tab" data-order="old" aria-pressed="true">{labels.timelineOldest}</button>
            <button type="button" class="tab" data-order="new" aria-pressed="false">{labels.timelineNewest}</button>
          </div>
          <nav class="tl-nav" aria-label={labels.timelineJump} data-nav>
            {years.map((y) => <a href={`#y${y}`}>{labels.yearPrefix} {y + 543}</a>)}
          </nav>
          <div data-years>
            {years.map((y) => {
              const mem = memories(y);
              return (
                <section class="tl-year" id={`y${y}`} data-lb-scope>
                  <h2 class="section-title">{labels.yearPrefix} {y + 543}</h2>
                  <ol class="tl">
                    {byYear(y).map((it) => (
                      <li class:list={['tl-item', 'reveal', it.major ? 'is-major' : 'is-minor']}>
                        <div class="tl-card">
                          {it.major ? (
                            <>
                              {!it.yearOnly && <time datetime={iso(it.date)}>{fmtDate(it.date)}</time>}
                              <h3>{it.href ? <a href={it.href} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener' : undefined}>{it.title}</a> : it.title}</h3>
                              {it.html && <div class={`prose ta-${it.ta} fs-${it.fs}`} set:html={it.html} />}
                              {it.photo && (
                                <button type="button" class={`zoom blk al-${it.align}`} style={`--w:${it.size}%`} data-zoom aria-label={it.photo.alt ? undefined : labels.zoomImage}>
                                  <img src={it.photo.src} alt={it.photo.alt} loading="lazy" decoding="async" />
                                </button>
                              )}
                            </>
                          ) : (
                            <>
                              <time datetime={iso(it.date)}>{fmtDate(it.date)}</time>
                              <a href={it.href ?? undefined}>{it.title}</a>
                            </>
                          )}
                        </div>
                        <div class="tl-mid" aria-hidden="true"><span class="tl-c1"></span><span class="tl-c2"></span><span class="tl-stub"></span><span class="tl-dot"></span></div>
                      </li>
                    ))}
                  </ol>
                  {mem.man.length + mem.pool.length > 0 && (
                    <div class="tl-memories" data-memories data-n={mem.quota}>
                      <h3>{labels.memoriesTitle}</h3>
                      <div class="album uniform" style="--cols:4;--ar:4 / 3">
                        {mem.man.map((p) => (
                          <button type="button" class="zoom" data-zoom aria-label={p.alt ? undefined : labels.zoomImage}>
                            <img src={p.src} alt={p.alt} loading="lazy" decoding="async" />
                          </button>
                        ))}
                        {mem.pool.map((p, i) => (
                          <button type="button" class="zoom" data-zoom data-pool hidden={i >= mem.quota} aria-label={p.alt ? undefined : labels.zoomImage}>
                            <img src={p.src} alt={p.alt} loading="lazy" decoding="async" />
                          </button>
                        ))}
                      </div>
                    </div>
                  )}
                </section>
              );
            })}
          </div>
        </>
      ) : (
        <p class="empty">{labels.timelineEmpty}</p>
      )}
    </div>
  </section>
</Base>

<script>
  // ภาพความทรงจำ: สุ่มรูปจากข่าวมาแสดงใหม่ทุกครั้งที่เปิดหน้า (จำนวน = ข่าว × 1.5)
  document.querySelectorAll<HTMLElement>('[data-memories]').forEach((box) => {
    const pool = Array.from(box.querySelectorAll<HTMLElement>('[data-pool]'));
    const n = Number(box.dataset.n) || 0;
    if (pool.length <= n) return;
    const idx = pool.map((_, i) => i);
    for (let k = idx.length - 1; k > 0; k--) {
      const r = Math.floor(Math.random() * (k + 1));
      [idx[k], idx[r]] = [idx[r], idx[k]];
    }
    const pick = new Set(idx.slice(0, n));
    pool.forEach((el, i) => (el.hidden = !pick.has(i)));
  });

  const root = document.querySelector<HTMLElement>('[data-timeline]');
  const years = root?.querySelector<HTMLElement>('[data-years]');
  const nav = root?.querySelector<HTMLElement>('[data-nav]');
  if (root && years && nav) {
    const btns = Array.from(root.querySelectorAll<HTMLElement>('[data-order]'));
    const flip = (parent: Element) => Array.from(parent.children).reverse().forEach((c) => parent.append(c));
    let current = 'old'; // ลำดับตามที่สร้างจากเซิร์ฟเวอร์ = เก่าไปใหม่
    const set = (order: string) => {
      if (order !== current) {
        flip(years);
        years.querySelectorAll('.tl').forEach(flip);
        flip(nav);
        current = order;
      }
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.order === order)));
      try { localStorage.setItem('tlOrder', order); } catch (e) {}
    };
    btns.forEach((b) => b.addEventListener('click', () => set(b.dataset.order!)));
    try { if (localStorage.getItem('tlOrder') === 'new') set('new'); } catch (e) {}
  }
</script>
