---
// พื้นที่ครูผู้สอน (ต้องเข้าสู่ระบบ): เพิ่ม/แก้ไข/ลบคอร์สของตัวเอง ฝากเอกสาร แก้โปรไฟล์ — ทำงานผ่าน Cloudflare Worker
import Base from '../layouts/Base.astro';
import { labels, url } from '../lib/site';
const L = Object.fromEntries(Object.entries(labels).filter(([k]) => k.startsWith('tc') || k === 'docDownload'));
---
<Base title={labels.tcTitle}>
  <Fragment slot="head"><meta name="robots" content="noindex" /></Fragment>
  <section class="section">
    <div class="container" data-teacher data-login={url('/login/')} data-data={url('/data/teacher-api.json')} data-base={url('/')} data-accounts={url('/admin/accounts.html')}>
      <script type="application/json" set:html={JSON.stringify(L)} />
      <div class="tc-hero" data-hero></div>
      <div data-stats class="tc-stats"></div>
      <div class="tc-tabs" data-tabs></div>
      <p class="tc-flash" data-flash role="status">{labels.tcLoading}</p>
      <div data-main></div>
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-teacher]');
  if (root) {
    const L = JSON.parse(root.querySelector('script[type="application/json"]')!.textContent || '{}');
    const q = (s: string) => root.querySelector<HTMLElement>(s)!;
    const [hero, stats, tabs, flash, main] = ['[data-hero]', '[data-stats]', '[data-tabs]', '[data-flash]', '[data-main]'].map(q);
    const base = root.dataset.base!;
    const sess = JSON.parse(sessionStorage.getItem('bffTeacher') || 'null');
    const leave = () => { sessionStorage.removeItem('bffTeacher'); location.replace(root.dataset.login!); };
    const ALLOWED = ['pdf', 'doc', 'docx', 'ppt', 'pptx', 'xls', 'xlsx', 'zip', 'rar', '7z', 'txt', 'csv', 'png', 'jpg', 'jpeg', 'webp', 'gif'];
    const h = (tag: string, props: Record<string, any> = {}, ...kids: any[]) => { const el = document.createElement(tag); Object.assign(el, props); el.append(...kids.flat().filter((k) => k != null && k !== false)); return el; };
    const replace = (el: HTMLElement, ...kids: any[]) => el.replaceChildren(...kids.flat(Infinity).filter((k) => k != null && k !== false));
    const say = (t: string) => (flash.textContent = t);
    let S: any = null;
    let tab = 'courses';

    const api = async (path: string, init: RequestInit = {}) => {
      const r = await fetch(sess.api.replace(/\/$/, '') + path, { ...init, headers: { ...(init.headers || {}), Authorization: 'Bearer ' + sess.token } });
      if (r.status === 401) { say(L.tcSessionExpired); setTimeout(leave, 1500); throw new Error('auth'); }
      const j = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(j.error || 'error');
      return j;
    };
    const reload = async () => { const site = S?.site; S = await api('/state'); S.site = site || (await fetch(root.dataset.data!).then((r) => r.json())); };
    const status = (c: any) => (c.ended ? 'ended' : c.closed ? 'closed' : c.applyUrl ? 'open' : null);
    const chip = (s: string | null) => (s ? h('span', { className: `badge badge-${s}`, textContent: s === 'ended' ? L.tcStatEnded : s === 'closed' ? L.tcStatClosed : L.tcStatOpen }) : null);
    const subjectTitle = (slug: string) => S.subjects.find((x: any) => x.slug === slug)?.title || slug;
    const allowedSubjects = () => S.subjects.filter((s: any) => S.user.all || S.site.courses.some((c: any) => c.page === s.slug && c.teachers.includes(S.user.teacher)));
    const managed = () => S.site.courses.filter((c: any) => S.owned.includes(c.key));

    // ───── ส่วนประกอบฟอร์ม ─────
    const input = (v: any, on: (s: string) => void, type = 'text', extra: any = {}) => h('input', { type, value: v ?? '', oninput: (e: Event) => on((e.target as HTMLInputElement).value), ...extra });
    const field = (label: string, el: HTMLElement) => h('label', {}, h('span', {}, label), el);
    const check = (label: string, v: boolean, on: (b: boolean) => void) => h('label', { className: 'tc-check' }, h('input', { type: 'checkbox', checked: !!v, onchange: (e: Event) => on((e.target as HTMLInputElement).checked) }), label);
    const upload = async (f: File, imagesOnly = false) => {
      const ext = (f.name.split('.').pop() || '').toLowerCase();
      if (!ALLOWED.includes(ext) || (imagesOnly && !['png', 'jpg', 'jpeg', 'webp', 'gif'].includes(ext))) throw new Error(L.tcFileType);
      if (f.size > 6 * 1024 * 1024) throw new Error(L.tcFileTooBig);
      const b64 = await new Promise<string>((res) => { const fr = new FileReader(); fr.onload = () => res(String(fr.result).split(',')[1]); fr.readAsDataURL(f); });
      return (await api('/upload?name=' + encodeURIComponent(f.name), { method: 'POST', headers: { 'Content-Type': 'text/plain' }, body: b64 })).file as string;
    };
    const docsEditor = (d: any) => {
      const ul = h('ul', { className: 'tc-docs' });
      const draw = () => replace(ul, ...d.documents.map((x: any, i: number) => h('li', {},
        input(x.title, (s) => (x.title = s), 'text', { ariaLabel: L.tcDocTitle }), input(x.note || '', (s) => (x.note = s), 'text', { placeholder: L.tcDocNote, ariaLabel: L.tcDocNote }),
        h('small', {}, (x.file || '').split('/').pop()), h('button', { type: 'button', className: 'btn btn-outline', textContent: L.tcRemove, onclick: () => { d.documents.splice(i, 1); draw(); } }))));
      draw();
      const file = h('input', { type: 'file', accept: ALLOWED.map((x) => '.' + x).join(',') }) as HTMLInputElement;
      file.addEventListener('change', async () => {
        const f = file.files?.[0]; if (!f) return;
        say(L.tcUploading);
        try { d.documents.push({ title: f.name.replace(/\.[^.]+$/, ''), file: await upload(f), note: '' }); draw(); say(''); } catch (e: any) { say(e.message === 'error' ? L.tcError : e.message); }
        file.value = '';
      });
      return h('div', {}, h('h4', {}, L.tcDocs), ul, field(L.tcAddFile, file));
    };
    const linksEditor = (d: any) => {
      const box = h('div', {});
      const draw = () => replace(box, ...d.links.map((l: any, i: number) => h('div', { className: 'tc-link-row' },
        input(l.label, (s) => (l.label = s), 'text', { placeholder: L.tcLinkLabel, ariaLabel: L.tcLinkLabel }), input(l.url, (s) => (l.url = s), 'url', { placeholder: L.tcLinkUrl, ariaLabel: L.tcLinkUrl }),
        h('button', { type: 'button', className: 'btn btn-outline', textContent: L.tcRemove, onclick: () => { d.links.splice(i, 1); draw(); } }))));
      draw();
      return h('div', {}, h('h4', {}, L.tcLinks), box, h('button', { type: 'button', className: 'btn btn-outline', textContent: L.tcAddLink, onclick: () => { d.links.push({ label: '', url: '' }); draw(); } }));
    };
    const guard = async (fn: () => Promise<void>) => { say(L.tcSaving); try { await fn(); } catch (e: any) { if (e.message !== 'auth') say(L.tcError); } };

    // ───── แก้ไขคอร์สที่ครูสร้าง (เต็มรูปแบบ) ─────
    const editCourse = (id: string | null, data: any) => {
      const availableSubjects = allowedSubjects();
      const d = { subject: availableSubjects[0]?.slug || '', title: '', group: '', startDate: '', endDate: '', schedule: '', teachers: [S.user.teacher].filter(Boolean), description: '', applyUrl: '', closed: false, ended: false, documents: [], links: [], ...(data || {}) };
      d.documents = [...(d.documents || [])]; d.links = (d.links || []).map((l: any) => ({ ...l })); d.teachers = [...(d.teachers || [])];
      const subj = h('select', { onchange: (e: Event) => (d.subject = (e.target as HTMLSelectElement).value) }, ...availableSubjects.map((s: any) => h('option', { value: s.slug, textContent: s.title, selected: s.slug === d.subject })));
      const tchecks = h('div', { className: 'checks' }, ...S.teachers.map((t: any) => check(t.name, d.teachers.includes(t.id), (b) => { d.teachers = b ? [...d.teachers, t.id] : d.teachers.filter((x: string) => x !== t.id); })));
      replace(main, h('div', { className: 'tc-form' },
        h('button', { type: 'button', className: 'btn btn-outline', textContent: L.tcBack, onclick: () => render() }),
        field(L.tcSubject, subj), field(L.tcCourseTitle, input(d.title, (s) => (d.title = s))), field(L.tcGroup, input(d.group, (s) => (d.group = s))),
        h('div', { className: 'two' }, field(L.tcStart, input(d.startDate, (s) => (d.startDate = s), 'date')), field(L.tcEnd, input(d.endDate, (s) => (d.endDate = s), 'date'))),
        field(L.tcSchedule, h('textarea', { rows: 2, value: d.schedule, oninput: (e: Event) => (d.schedule = (e.target as HTMLTextAreaElement).value) })),
        h('div', {}, h('span', { style: 'font-weight:600' }, L.tcTeachers), tchecks),
        field(L.tcDesc, h('textarea', { rows: 5, value: d.description, oninput: (e: Event) => (d.description = (e.target as HTMLTextAreaElement).value) })),
        field(L.tcApplyUrl, input(d.applyUrl, (s) => (d.applyUrl = s), 'url', { placeholder: 'https://' })),
        h('div', { className: 'checks' }, check(L.tcClosed, d.closed, (b) => (d.closed = b)), check(L.tcEnded, d.ended, (b) => (d.ended = b))),
        docsEditor(d), linksEditor(d),
        h('div', { className: 'tc-actions' },
          h('button', { type: 'button', className: 'btn', textContent: L.tcSave, onclick: () => guard(async () => { await api('/course/save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, data: d }) }); await reload(); tab = 'courses'; render(); say(L.tcSaved); }) }),
          h('button', { type: 'button', className: 'btn btn-outline', textContent: L.tcCancel, onclick: () => render() }),
          id && h('button', { type: 'button', className: 'btn btn-outline danger', textContent: L.tcDeleteCourse, onclick: () => { if (confirm(L.tcConfirmDelete)) guard(async () => { await api('/course/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) }); await reload(); render(); say(''); }); } }))));
    };

    // ───── แก้ไขคอร์สที่ผู้ดูแลสร้าง (ลิงก์สมัคร สถานะ เอกสาร) ─────
    const editManaged = (c: any) => {
      const u = S.updates[c.key] || {};
      const d: any = { applyUrl: u.applyUrl ?? c.base.applyUrl ?? '', closed: u.closed ?? c.base.closed, ended: u.ended ?? c.base.ended, documents: [...(u.documents || [])] };
      replace(main, h('div', { className: 'tc-form' },
        h('button', { type: 'button', className: 'btn btn-outline', textContent: L.tcBack, onclick: () => render() }),
        h('h3', {}, c.title), h('p', { className: 'muted' }, c.pageTitle),
        field(L.tcApplyUrl, input(d.applyUrl, (s) => (d.applyUrl = s), 'url', { placeholder: 'https://' })),
        h('div', { className: 'checks' }, check(L.tcClosed, d.closed, (b) => (d.closed = b)), check(L.tcEnded, d.ended, (b) => (d.ended = b))),
        c.base.documents.length ? h('div', {}, h('h4', {}, L.tcDocsBase), h('ul', { className: 'tc-docs' }, ...c.base.documents.map((x: any) => h('li', {}, x.title)))) : null,
        docsEditor(d),
        h('div', { className: 'tc-actions' },
          h('button', { type: 'button', className: 'btn', textContent: L.tcSave, onclick: () => guard(async () => { await api('/save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ updates: { [c.key]: d } }) }); await reload(); render(); say(L.tcSaved); }) }),
          h('button', { type: 'button', className: 'btn btn-outline', textContent: L.tcCancel, onclick: () => render() }))));
    };

    // ───── โปรไฟล์ ─────
    const renderProfile = () => {
      if (!S.profile) return replace(main, h('p', { className: 'empty' }, L.tcNoProfile));
      const d: any = { name: '', position: '', email: '', phone: '', instagram: '', facebook: '', youtube: '', ...S.profile, photo: { ...(S.profile.photo || {}) } };
      const file = h('input', { type: 'file', accept: 'image/png,image/jpeg,image/webp,image/gif' }) as HTMLInputElement;
      file.addEventListener('change', async () => {
        const f = file.files?.[0]; if (!f) return;
        say(L.tcUploading);
        try { d.photo = { src: await upload(f, true), alt: d.name }; say(f.name); } catch (e: any) { say(e.message === 'error' ? L.tcError : e.message); }
      });
      replace(main, h('div', { className: 'tc-form' },
        field(L.tcName, input(d.name, (s) => (d.name = s))), field(L.tcPosition, input(d.position, (s) => (d.position = s))), field(L.tcPhoto, file),
        h('div', { className: 'two' }, field(L.tcEmail, input(d.email, (s) => (d.email = s), 'email')), field(L.tcPhone, input(d.phone, (s) => (d.phone = s), 'tel'))),
        field(L.tcInstagram, input(d.instagram, (s) => (d.instagram = s), 'url')), field(L.tcFacebook, input(d.facebook, (s) => (d.facebook = s), 'url')), field(L.tcYoutube, input(d.youtube, (s) => (d.youtube = s), 'url')),
        h('div', { className: 'tc-actions' }, h('button', { type: 'button', className: 'btn', textContent: L.tcSave, onclick: () => guard(async () => { await api('/profile/save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ data: d }) }); await reload(); render(); say(L.tcSaved); }) }))));
    };

    // ───── รายการคอร์ส + ภาพรวม ─────
    const card = (title: string, sub: string, c: any, onEdit: () => void, color: string) => {
      const docs = (c.documents || c.base?.documents || []).length;
      return h('article', { className: 'tc-card', style: `border-top-color:var(${color})` }, h('div', {}, chip(status(c.base ?? c))), h('h3', {}, title), h('span', { className: 'muted' }, sub), docs ? h('span', { className: 'muted' }, `${L.tcStatDocs}: ${docs}`) : null, h('button', { type: 'button', className: 'btn btn-outline', textContent: L.tcEdit, onclick: onEdit }));
    };
    const renderCourses = () => {
      const mine = S.myCourses, man = managed();
      const colors = ['--c-green', '--c-blue', '--c-red'];
      replace(main, 
        h('p', {}, h('button', { type: 'button', className: 'btn', textContent: L.tcAddCourse, onclick: () => (allowedSubjects().length ? editCourse(null, null) : say(L.tcNoSubjects)) })),
        mine.length ? [h('h3', { className: 'tc-section-title' }, L.tcMyCourses), h('div', { className: 'tc-grid' }, ...mine.map((m: any, i: number) => card(m.data.title, subjectTitle(m.data.subject), m.data, () => editCourse(m.id, m.data), colors[i % 3])))] : null,
        man.length ? [h('h3', { className: 'tc-section-title' }, L.tcManaged), h('div', { className: 'tc-grid' }, ...man.map((c: any, i: number) => card(c.title, c.pageTitle, { ...c, ...(S.updates[c.key] || {}), base: { ...c.base, ...(S.updates[c.key] || {}) } }, () => editManaged(c), colors[i % 3])))] : null,
        !mine.length && !man.length ? h('p', { className: 'empty' }, L.tcNoCourses) : null);
    };

    const render = () => {
      const photo = S.profile?.photo?.src;
      const role = S.user.owner ? L.tcRoleOwner : S.user.all ? L.tcRoleAdmin : L.tcRoleTeacher;
      replace(hero, 
        h('span', { className: 'tc-avatar' }, photo ? h('img', { src: base + photo.replace(/^\//, ''), alt: '' }) : (S.user.name || '?').charAt(0)),
        h('div', { className: 'tc-who' }, h('strong', {}, `${L.tcHello} ${S.user.name}`), h('span', { className: 'tc-role' }, role)),
        S.user.owner ? h('a', { className: 'btn btn-outline', href: root.dataset.accounts!, textContent: L.tcManageAccounts }) : null,
        h('button', { type: 'button', className: 'btn btn-outline', textContent: L.tcLogout, onclick: leave }));
      if (S.user.owner) { replace(stats, ); replace(tabs, ); return replace(main, h('p', { className: 'empty' }, L.tcOwnerNote)); }
      const all = [...S.myCourses.map((m: any) => m.data), ...managed().map((c: any) => ({ ...c.base, ...(S.updates[c.key] || {}) }))];
      const num = (n: number, t: string) => h('div', { className: 'tc-stat' }, h('b', {}, String(n)), t);
      replace(stats, num(all.length, L.tcStatCourses), num(all.filter((c) => status(c) === 'open').length, L.tcStatOpenCount), num(all.reduce((n, c) => n + (c.documents || []).length, 0), L.tcStatDocs));
      replace(tabs, ...[['courses', L.tcTabCourses], ['profile', L.tcTabProfile]].map(([k, t]) => h('button', { type: 'button', className: 'tab', textContent: t, ariaPressed: String(tab === k), onclick: () => { tab = k; render(); } })));
      tab === 'profile' ? renderProfile() : renderCourses();
    };

    (async () => {
      if (!sess || sess.exp < Date.now()) return leave();
      try { await reload(); say(''); render(); } catch { if (!flash.textContent || flash.textContent === L.tcLoading) say(L.tcError); }
    })();
  }
</script>
