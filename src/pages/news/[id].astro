---
// หน้าข่าวแต่ละเรื่อง (สร้างเฉพาะข่าวที่สถานะ "เผยแพร่")
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sections from '../../components/Sections.astro';
import Share from '../../components/Share.astro';
import { getPublishedPosts, labels, url, img, fmtDate, iso, plain } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const cover = img(d.cover, `(ข่าว: ${d.title})`);
const hasIntro = !!post.body?.trim();
const isUpdated = !!(d.updated && d.date && d.updated.getTime() - d.date.getTime() >= 86400000);
const pick = (v: any, ok: string[], x: string) => (ok.includes(v) ? v : x);
const coverAlign = pick(d.coverAlign, ['left', 'center', 'right'], 'center');
const bodyAlign = pick(d.bodyAlign, ['left', 'center', 'right', 'justify'], 'left');
const bodySize = pick(d.bodySize, ['normal', 'large', 'xlarge'], 'normal');
---
<Base title={d.title} description={plain(post.body) || d.title} image={cover?.src}>
  <header class="page-band">
    <div class="container narrow">
      <a class="back" href={url('/news/')}>← {labels.backToNews}</a>
      <div class="badges">
        {d.isNew && <span class="badge badge-new">{labels.newBadge}</span>}
        {isUpdated && <span class="badge badge-upd">{labels.updateBadge}</span>}
        {d.category && <span class="badge badge-cat">{d.category}</span>}
      </div>
      <h1>{d.title}</h1>
      <p class="meta">
        {d.date && <span>{labels.postedOn} <time datetime={iso(d.date)}>{fmtDate(d.date)}</time></span>}
        {d.updated && <span>{labels.updatedOn} <time datetime={iso(d.updated)}>{fmtDate(d.updated)}</time></span>}
      </p>
    </div>
  </header>
  <article class="section pull-up">
    <div class="container narrow">
      <div class="paper" data-lb-scope>
        {cover && <img class={`post-cover blk al-${coverAlign}`} style={`--w:${d.coverSize ?? 100}%`} src={cover.src} alt={cover.alt} />}
        {hasIntro && <div class={`prose ta-${bodyAlign} fs-${bodySize}`}><Content /></div>}
        <Sections sections={d.sections} />
      </div>
      <Share />
    </div>
  </article>
</Base>
