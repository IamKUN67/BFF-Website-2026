---
// หน้าทั่วไปทุกหน้า: (ผู้บริหาร) → เนื้อหา/ลิงก์/ติดต่อ → ครูผู้สอน → คอร์สเรียน → ข่าวหมวดที่เลือก
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContactChannels from '../../components/ContactChannels.astro';
import Executives from '../../components/Executives.astro';
import Teachers from '../../components/Teachers.astro';
import Courses from '../../components/Courses.astro';
import PostCard from '../../components/PostCard.astro';
import Sections from '../../components/Sections.astro';
import Embeds from '../../components/Embeds.astro';
import Icon from '../../components/Icon.astro';
import { getSite, getPublishedPosts, labels, url } from '../../lib/site';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({ params: { slug: page.data.slug ?? page.id }, props: { page } }));
}
const { page } = Astro.props;
const d = page.data;
const { Content } = await render(page);
const site = await getSite();
const hasBody = !!page.body?.trim();
const pick = (v: any, ok: string[], x: string) => (ok.includes(v) ? v : x);
const bodyAlign = pick(d.bodyAlign, ['left', 'center', 'right', 'justify'], 'left');
const bodySize = pick(d.bodySize, ['normal', 'large', 'xlarge'], 'normal');
const news = d.newsCategory ? (await getPublishedPosts()).filter((p) => p.data.category === d.newsCategory).slice(0, 6) : [];
const hasMain = d.showContact || d.links.length > 0 || d.embeds.length > 0 || hasBody || d.sections.length > 0;
---
<Base title={d.title} description={d.description}>
  <header class="page-band"><div class="container narrow"><h1>{d.title}</h1></div></header>
  {d.showExecutives && <section class="section first"><div class="container"><Executives /></div></section>}
  <article class={hasMain ? (d.showExecutives ? 'section' : 'section pull-up') : 'pull-up'}>
    <div class="container narrow">
      {hasMain && (
        <div class="paper">
          {d.links.length > 0 && (
            <div class="link-cards">
              {d.links.map((l) => (
                <a class={`link-card blk al-${pick(l.align, ['left', 'center', 'right'], 'center')}`} style={`--w:${l.width ?? 100}%`} href={url(l.url)} target="_blank" rel="noopener">
                  <span class="lc-icon"><Icon name="external" size={26} /></span>
                  <span class="lc-text"><strong>{l.label}</strong>{l.note && <span>{l.note}</span>}</span>
                  <span class="lc-go">{labels.openLink}<span class="sr-only"> ({labels.externalHint})</span></span>
                </a>
              ))}
            </div>
          )}
          {d.embeds.length > 0 && <Embeds embeds={d.embeds} />}
          {d.showContact && <ContactChannels site={site} />}
          {hasBody && <div class={`prose ta-${bodyAlign} fs-${bodySize}`}><Content /></div>}
          <Sections sections={d.sections} />
        </div>
      )}
    </div>
  </article>
  {d.teachers.length > 0 && <section class="section alt"><div class="container"><Teachers ids={d.teachers} /></div></section>}
  {d.courses.length > 0 && <section class="section"><div class="container"><Courses courses={d.courses} pageSlug={d.slug ?? page.id} /></div></section>}
  {news.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head"><h2 class="section-title">{labels.relatedNews}</h2></div>
        <div class="card-grid">{news.map((p) => <PostCard post={p} />)}</div>
        <p class="center"><a class="btn btn-outline" href={url(`/news/?category=${encodeURIComponent(d.newsCategory!)}`)}>{labels.allNews}</a></p>
      </div>
    </section>
  )}
</Base>
