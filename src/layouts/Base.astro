---
// โครงหน้าทุกหน้า: meta, สีธีมจากหน้าตั้งค่า, โหมดมืด, เมนู, ท้ายเว็บ
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import Lightbox from '../components/Lightbox.astro';
import SearchDialog from '../components/SearchDialog.astro';
import FontSize from '../components/FontSize.astro';
import { getSite, getMenu, labels, onColor, plain, img } from '../lib/site';

const { title, description, image, bare = false } = Astro.props;
const site = await getSite();
const menu = await getMenu();
const { primary, accent } = site.colors;
const fullTitle = title ? `${title} | ${site.siteName}` : site.siteName;
const logo = img(site.logo, '(โลโก้)');
const gc = /^[a-z0-9-]+$/i.test(site.goatcounterCode ?? '') ? site.goatcounterCode : null;
const cf = /^[\w-]{8,64}$/.test(site.cloudflareToken ?? '') ? site.cloudflareToken : null;
const desc = description ?? plain(site.welcomeText ?? site.tagline ?? '');
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={fullTitle} description={desc} image={image ?? logo?.src} siteName={site.siteName} />
    <slot name="head" />
    {logo && <link rel="icon" type="image/webp" href={logo.src} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700&display=swap" rel="stylesheet" />
    {gc && <script is:inline data-goatcounter={`https://${gc}.goatcounter.com/count`} async src="//gc.zgo.at/count.js"></script>}
    {cf && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cf })}></script>}
    <style set:html={`:root{--primary:${primary};--accent:${accent};--on-primary:${onColor(primary)};--on-accent:${onColor(accent)}}`} />
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try { var f = localStorage.getItem('fs'); if (f) document.documentElement.dataset.fs = f; } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{labels.skipToContent}</a>
    {!bare && <Header site={site} menu={menu} />}
    <main id="main"><slot /></main>
    {!bare && <Footer site={site} />}
    <Lightbox />
    {!bare && <SearchDialog />}
    {!bare && <FontSize />}
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; }
        var io = new IntersectionObserver(function (list) {
          list.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } });
        }, { threshold: 0.12 });
        els.forEach(function (e) { io.observe(e); });
      })();
    </script>
  </body>
</html>
